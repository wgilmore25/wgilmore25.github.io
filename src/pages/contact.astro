---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';
---
<BaseLayout title="Contact">
  <section class="shell page-intro"><p class="eyebrow">Contact</p><h1>Let’s put the<br /><em>evidence to work.</em></h1><p class="intro-description">For conversations about human performance leadership, assessment systems, exercise-program evaluation, and applied data analysis.</p></section>
  <section class="shell contact-details section-bottom" aria-label="Contact details">
    <div><h2>Email</h2><a class="contact-email" href={`mailto:${profile.email}`}>{profile.email}</a></div>
    <div><h2>Project code</h2><a class="text-link" href={profile.github}>GitHub · wgilmore25</a></div>
  </section>
</BaseLayout>

