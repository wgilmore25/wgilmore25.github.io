---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';
import { href } from '../lib/paths';
---
<BaseLayout title="About">
  <section class="shell page-intro about-intro">
    <div><p class="eyebrow">About</p><h1>A coaching foundation.<br /><em>A broader perspective.</em></h1></div>
    <figure class="about-coaching">
      <img src={href('images/apc-coaching-1400.webp')} srcset={`${href('images/apc-coaching-700.webp')} 700w, ${href('images/apc-coaching-1400.webp')} 1400w`} sizes="(max-width: 640px) calc(100vw - 2.5rem), (max-width: 900px) min(40rem, calc(100vw - 3rem)), 34rem" width="1400" height="1180" alt="Will Gilmore coaching an athlete during a medicine-ball exercise at the Red Bull Athlete Performance Center." fetchpriority="high" decoding="async" />
      <figcaption>Coaching at the Red Bull Athlete Performance Center.</figcaption>
    </figure>
  </section>
  <section class="shell about-body section-bottom">
    <div class="about-narrative prose">
      <h2>Working across the whole system.</h2>
      <p>My background spans professional baseball, athlete performance at Red Bull, and the development of analytical tools and decision frameworks.</p>
      <p>At the Cincinnati Reds, my responsibilities included leading 10 coaches across six teams, coordinating budgets and logistics, and establishing shared department standards. In rehabilitation, I worked with physical therapists to develop organization-wide return-to-play protocols.</p>
      <p>At the Red Bull Athlete Performance Center, I worked with health and performance staff on individual athlete programs, sport science assessments, dashboards, and reports.</p>
      <p>My recent project work explores how to interpret performance data, make recommendations explicit, and evaluate the quality of AI-generated exercise programs.</p>
      <a class="button secondary" href={href('downloads/will-gilmore-resume.pdf')} download>Download résumé · PDF</a>
    </div>
    <aside class="education"><p class="eyebrow">Education & credentials</p>
      <h3>Australian Catholic University</h3><p>Master’s of High Performance Sport<br />2020</p>
      <h3>Santa Clara University</h3><p>BA, Communication · 2011<br />NCAA Division I Baseball</p>
      <h3>NSCA</h3><p>Certified Strength and Conditioning Specialist<br />Registered Strength and Conditioning Coach with Distinction<br />Certified Performance and Sport Scientist</p>
    </aside>
  </section>
  <section class="shell section timeline-section">
    <div class="section-heading"><div><p class="eyebrow">Experience</p><h2>Where the work developed.</h2></div></div>
    <ol class="timeline">{profile.experience.map(item => <li>
      <p class="timeline-date">{item.dates}</p>
      <div>
        <h3>{item.organization}</h3>
        <p class="timeline-role">{item.role}</p>
        <p>{item.description}</p>
        {item.organization === 'Kansas City Royals' && (
          <figure class="career-photo">
            <img src={href('images/royals-field.webp')} width="1000" height="994" alt="Will Gilmore at the ballpark in Kansas City Royals training apparel, carrying a foam roller." loading="lazy" decoding="async" />
            <figcaption>On the field with the Kansas City Royals.</figcaption>
          </figure>
        )}
      </div>
    </li>)}</ol>
  </section>
</BaseLayout>

<style>
  .about-intro { display: grid; grid-template-columns: 1.1fr 1fr; gap: 3.5rem; align-items: center; }
  .about-intro h1 { font-size: clamp(2.4rem, 4.4vw, 4rem); }
  .about-coaching { min-width: 0; }
  .about-coaching img { width: 100%; height: auto; border-radius: 4px; }
  @media (max-width: 900px) {
    .about-intro { grid-template-columns: 1fr; gap: 2rem; }
    .about-coaching { max-width: 40rem; }
  }
  .career-photo { width: 100%; max-width: 26rem; margin-top: 1.5rem; }
  .career-photo img { width: 100%; height: auto; border-radius: 4px; }
</style>
