---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import WritingPreview from '../components/WritingPreview.astro';
import { getCollection } from 'astro:content';
import { href } from '../lib/paths';
const projects = (await getCollection('work')).filter(p => p.data.featured).sort((a,b) => a.data.order - b.data.order);
const articles = (await getCollection('writing')).sort((a,b) => +b.data.date - +a.data.date);
---
<BaseLayout>
  <section class="shell hero">
    <div class="hero-copy">
      <p class="eyebrow">Exercise physiology · Data science · AI evaluation</p>
      <h1>From exercise science to <em>informed decisions.</em></h1>
      <p class="hero-description">I’m Will Gilmore. I build assessment systems, analytical tools, and shared standards that help people make informed training decisions.</p>
      <div class="actions">
        <a class="button" href={href('work/')}>View selected work</a>
        <a class="text-link" href={href('about/')}>About me</a>
      </div>
    </div>
    <aside class="hero-profile" aria-label="Professional background">
      <img class="portrait" src={href('images/portrait.webp')} width="198" height="203" alt="Will Gilmore" fetchpriority="high" />
      <p class="profile-name">Coaching experience.<br />A systems perspective.</p>
      <p>Professional baseball<br />Red Bull Athlete Performance Center</p>
    </aside>
  </section>
  <div class="experience-strip">
    <div class="shell experience-inner">
      <p class="eyebrow">Experience across elite sport</p>
      <ul aria-label="Previous organizations"><li>Kansas City Royals</li><li>Cincinnati Reds</li><li>Red Bull APC</li></ul>
    </div>
  </div>
  <section class="shell section">
    <div class="section-heading"><div><p class="eyebrow">Selected work</p><h2>Evidence into practice.</h2></div><a class="text-link" href={href('work/')}>Explore all work</a></div>
    <div class="project-grid">{projects.map((project,i) => <ProjectCard project={project} featured={i === 0} />)}</div>
  </section>
  <section class="practice-section">
    <div class="shell practice-grid">
      <div><p class="eyebrow">A career in human performance</p><h2>The athlete. <br />The data. <br />The team.</h2><a class="text-link" href={href('about/')}>Explore my background</a></div>
      <div class="practice-body">
        <p class="large-copy">My work connects the individual training decision with the systems that support it.</p>
        <p>At the Cincinnati Reds, I managed coaches, established department standards, and worked with physical therapists on shared rehabilitation protocols. At Red Bull APC, I combined athlete programming with assessments, dashboards, and reports.</p>
        <p>My portfolio follows that work into automated analysis and the evaluation of AI-generated exercise recommendations.</p>
      </div>
    </div>
  </section>
  <section class="shell section">
    <div class="section-heading"><div><p class="eyebrow">Writing</p><h2>Making the data understandable.</h2></div><a class="text-link" href={href('writing/')}>View writing</a></div>
    {articles.slice(0,1).map(article => <WritingPreview article={article} />)}
  </section>
  <section class="shell contact-band"><p class="eyebrow">Contact</p><h2>Let’s talk about<br />human performance.</h2><a class="button" href={href('contact/')}>Get in touch</a></section>
</BaseLayout>

